---
import Layout from '../../../layouts/Layout.astro';
import ContactCTA from '../../../components/ContactCTA.astro';
import { useTranslations, getLangFromUrl, getTranslatedPath } from '../../../utils/i18n';
import { icons } from '../../../utils/icons';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const industryKey = 'construction';
const roles = [0, 1, 2, 3];
const eyebrow = lang === 'en' ? 'Building & Trades' : 'Obra y Oficios';
const heroIcon = icons['tools'];
const heroImage = 'construction.jpg';
const rolesEyebrow = lang === 'en' ? 'Who We Place' : 'A Quién Colocamos';
const rolesTitle = lang === 'en' ? 'Typical Roles We Staff' : 'Roles Típicos';
const img = heroImage ? (import.meta.env.BASE_URL === '/' ? `/images/${heroImage}` : `${import.meta.env.BASE_URL}/images/${heroImage}`) : null;
---

<Layout title={t(`industries.${industryKey}.title`)}>
  <div class="relative overflow-hidden bg-gradient-to-br from-blue-900 via-blue-900 to-blue-950 text-white">
    <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-cyan-500/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 left-0 h-72 w-72 rounded-full bg-blue-600/20 blur-3xl"></div>
    <div class="container mx-auto px-4 relative z-10 py-20 lg:py-24">
      <div class={img ? 'grid lg:grid-cols-2 gap-12 lg:gap-16 items-center' : 'max-w-3xl mx-auto text-center flex flex-col items-center'}>
        <div class={img ? '' : 'flex flex-col items-center'}>
          <span class="inline-flex w-16 h-16 rounded-2xl bg-white/10 ring-1 ring-white/20 items-center justify-center [&>svg]:w-8 [&>svg]:h-8 [&>svg]:text-cyan-300" set:html={heroIcon}></span>
          <p class="mt-6 text-sm font-semibold uppercase tracking-[0.18em] text-cyan-300">{eyebrow}</p>
          <h1 class="mt-3 text-4xl md:text-5xl font-bold">{t(`industries.${industryKey}.title`)}</h1>
          <div class={img ? 'mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-500 to-cyan-400' : 'mx-auto mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-500 to-cyan-400'}></div>
          <p class="mt-6 text-xl text-blue-100 leading-relaxed max-w-xl">{t(`industries.${industryKey}.desc`)}</p>
          <div class="mt-8">
            <a href={getTranslatedPath('contact', lang)} class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-white text-blue-900 font-bold shadow-lg hover:-translate-y-0.5 hover:shadow-xl transition-all duration-300">
              {t('buttons.requestTalent')}
            </a>
          </div>
        </div>
        {img && (
          <div class="relative rounded-3xl overflow-hidden shadow-2xl ring-1 ring-white/10">
            <img src={img} alt={t(`industries.${industryKey}.title`)} class="w-full h-[320px] lg:h-[440px] object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-blue-950/55 to-transparent"></div>
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="reveal-stagger grid grid-cols-1 md:grid-cols-2 gap-8 mb-20 max-w-5xl mx-auto">
        <div class="group p-8 rounded-2xl bg-blue-50 ring-1 ring-blue-100 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md shadow-blue-600/25 flex items-center justify-center mb-6 transition-transform duration-300 group-hover:scale-110">
            <span class="w-7 h-7 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:text-white" set:html={icons['megaphone']}></span>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">{t('industries.common.valuePropTitle')}</h2>
          <p class="text-gray-600 leading-relaxed">{t('industries.common.valuePropDesc')}</p>
        </div>
        <div class="group p-8 rounded-2xl bg-emerald-50 ring-1 ring-emerald-100 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-emerald-500/10 transition-all duration-300">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-500 text-white shadow-md shadow-emerald-600/25 flex items-center justify-center mb-6 transition-transform duration-300 group-hover:scale-110">
            <span class="w-7 h-7 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:text-white" set:html={icons['shield-check']}></span>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">{t('industries.common.screeningTitle')}</h2>
          <p class="text-gray-600 leading-relaxed">{t('industries.common.screeningDesc')}</p>
        </div>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">{rolesEyebrow}</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">{rolesTitle}</h2>
          <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500"></div>
        </div>
        <div class="reveal-stagger grid grid-cols-1 sm:grid-cols-2 gap-4">
          {roles.map(i => (
            <div class="group flex items-center gap-4 p-5 rounded-2xl bg-white ring-1 ring-gray-100 shadow-sm hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/10 hover:ring-blue-100 transition-all duration-300">
              <span class="flex-shrink-0 w-11 h-11 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md shadow-blue-600/25 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4"></path></svg>
              </span>
              <span class="text-lg font-semibold text-gray-800">{t(`industries.${industryKey}.roles.${i}`)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <ContactCTA
    title={t('home.hero.ctaPrimary')}
    subtitle={t('forms.contact.subtitle')}
    primaryText={t('buttons.requestTalent')}
    primaryHref={getTranslatedPath('contact', lang)}
  />
</Layout>
