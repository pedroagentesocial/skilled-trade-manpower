---
import Layout from '../layouts/Layout.astro';
import HeroSplit from '../components/HeroSplit.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import IndustryCards from '../components/IndustryCards.astro';
import ProofBar from '../components/ProofBar.astro';
import TestimonialGrid from '../components/TestimonialGrid.astro';
import ProcessPreview from '../components/ProcessPreview.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { useTranslations, getTranslatedPath } from '../utils/i18n';
import { icons } from '../utils/icons';

const t = useTranslations('en');
---

<Layout title="Home">
  <HeroSplit
    slides={[
      {
        title: "Recruiting, Staffing & Skilled Trade Crews",
        subtitle: "Your workforce growth partner: recruiting, digital marketing, and managed delivery for better people, faster.",
        primaryCta: { text: "Request Crews", href: "/employers" },
        secondaryCta: { text: "Find Work", href: "/contact" },
        videoSrc: "/videos/Hero1-1.mp4"
      },
      {
        title: "Specialized Installation & Maintenance",
        subtitle: "From HVAC to industrial assembly, our managed teams execute with precision.",
        primaryCta: { text: "View Services", href: "/services" },
        secondaryCta: { text: "Get Quote", href: "/contact" },
        videoSrc: "/videos/Hero2.mp4"
      },
      {
        title: "We Are Your Execution Partner",
        subtitle: "Scale your workforce without the HR headaches. We take full responsibility.",
        primaryCta: { text: "Explore Services", href: "/services" },
        secondaryCta: { text: "About Us", href: "/about" },
        videoSrc: "/videos/Hero3.mp4"
      }
    ]}
  />
  
  <ProofBar />

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Why Skilled Trade Manpower</p>
      <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">Why Choose Us?</h2>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500"></div>
      <div class="reveal-stagger mt-14 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group rounded-2xl border border-blue-100 bg-blue-50/60 p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-blue-200 hover:bg-white hover:shadow-xl hover:shadow-blue-500/10">
          <div class="icon-tile mb-5 flex justify-center transition-transform duration-300 group-hover:scale-110" set:html={icons.bolt}></div>
          <h3 class="mb-2 text-xl font-bold text-gray-900">Fast Deployment</h3>
          <p class="text-gray-600">We can mobilize teams within 24-48 hours for urgent projects.</p>
        </div>
        <div class="group rounded-2xl border border-blue-100 bg-blue-50/60 p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-blue-200 hover:bg-white hover:shadow-xl hover:shadow-blue-500/10">
          <div class="icon-tile mb-5 flex justify-center transition-transform duration-300 group-hover:scale-110" set:html={icons['shield-check']}></div>
          <h3 class="mb-2 text-xl font-bold text-gray-900">Zero Liability</h3>
          <p class="text-gray-600">We handle all insurance, workers' comp, and payroll taxes.</p>
        </div>
        <div class="group rounded-2xl border border-blue-100 bg-blue-50/60 p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-blue-200 hover:bg-white hover:shadow-xl hover:shadow-blue-500/10">
          <div class="icon-tile mb-5 flex justify-center transition-transform duration-300 group-hover:scale-110" set:html={icons['check-badge']}></div>
          <h3 class="mb-2 text-xl font-bold text-gray-900">Quality Guaranteed</h3>
          <p class="text-gray-600">Our on-site supervisors ensure work meets your standards.</p>
        </div>
      </div>
    </div>
  </section>
  
  <ServicesGrid />

  <IndustryCards />

  <ProcessPreview />
  
  <TestimonialGrid />
  
  <ContactCTA 
    title="Ready to Delegate Your Project?"
    subtitle="Let us handle the execution so you can focus on your business."
    primaryText="Request Crews"
    primaryHref="/contact"
  />
</Layout>
