---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import { useTranslations } from '../utils/i18n';
import { icons } from '../utils/icons';

const t = useTranslations('en');
---

<Layout title="Contact Us">
  <div class="relative overflow-hidden bg-gradient-to-br from-blue-900 via-blue-900 to-blue-950 py-24 text-white text-center">
    <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-cyan-500/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 left-0 h-72 w-72 rounded-full bg-blue-600/20 blur-3xl"></div>
    <div class="container mx-auto px-4 relative z-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-300">Get In Touch</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold">Contact Us</h1>
      <p class="mt-5 text-xl text-blue-100 max-w-2xl mx-auto">
        Discuss your project with our execution team.
      </p>
      <div class="mx-auto mt-6 h-1 w-20 rounded-full bg-gradient-to-r from-blue-500 to-cyan-400"></div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 max-w-6xl mx-auto">
      <div>
        <div class="bg-blue-50 rounded-3xl p-8 md:p-12 relative overflow-hidden">
             <div class="absolute top-0 right-0 w-32 h-32 bg-blue-100 rounded-bl-full -mr-8 -mt-8 opacity-50"></div>
            
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600 relative z-10">Reach Us</p>
            <h2 class="mt-2 text-3xl font-bold text-gray-900 mb-8 relative z-10">Get in Touch</h2>
            <div class="reveal-stagger space-y-8 relative z-10">
            <div class="flex items-start group">
                <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md shadow-blue-600/25 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <span class="w-6 h-6" set:html={icons['map-pin']}></span>
                </div>
                <div class="ml-6">
                <h3 class="text-lg font-bold text-gray-900 mb-1">Address</h3>
                <p class="text-gray-600 leading-relaxed">
                    271 Cottonwood Drive<br />
                    Centerville, Utah 84014
                </p>
                </div>
            </div>

            <div class="flex items-start group">
                 <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md shadow-blue-600/25 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <span class="w-6 h-6" set:html={icons.phone}></span>
                </div>
                <div class="ml-6">
                <h3 class="text-lg font-bold text-gray-900 mb-1">Phone</h3>
                <p class="text-gray-600">
                    <a href="tel:3854012255" class="hover:text-blue-600 transition-colors font-medium">385 401 22 55</a>
                </p>
                </div>
            </div>

            <div class="flex items-start group">
                 <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md shadow-blue-600/25 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <span class="w-6 h-6" set:html={icons.envelope}></span>
                </div>
                <div class="ml-6 min-w-0">
                <h3 class="text-lg font-bold text-gray-900 mb-1">Email</h3>
                <p class="text-gray-600">
                    <a href="mailto:info@skilledtrademanpower.com" class="hover:text-blue-600 transition-colors font-medium break-all">info@skilledtrademanpower.com</a>
                </p>
                </div>
            </div>
            
            <div class="flex items-start group">
                 <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md shadow-blue-600/25 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <span class="w-6 h-6" set:html={icons.clock}></span>
                </div>
                <div class="ml-6">
                <h3 class="text-lg font-bold text-gray-900 mb-1">Hours</h3>
                <p class="text-gray-600 leading-relaxed">
                    Monday - Friday: 8:00 AM - 5:00 PM<br />
                    Saturday - Sunday: Closed
                </p>
                </div>
            </div>
            </div>
        </div>
      </div>

      <div class="bg-white p-8 md:p-10 rounded-3xl shadow-xl border border-gray-100 relative">
        <LeadForm />
      </div>
    </div>
  </div>
</Layout>
