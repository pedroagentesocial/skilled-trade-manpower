---
const stats = [
  { value: "500+", label: "Projects Delivered" },
  { value: "50+", label: "Corporate Partners" },
  { value: "10+", label: "Years Experience" },
  { value: "100%", label: "Completion Rate" },
];
---

<section class="py-14 bg-gradient-to-r from-slate-900 via-blue-950 to-slate-900 text-white">
  <div class="container mx-auto px-4">
    <div class="reveal-stagger grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {stats.map(stat => (
        <div class="p-4">
          <div class="text-4xl md:text-5xl font-extrabold text-cyan-300 mb-2 tracking-tight">{stat.value}</div>
          <div class="text-gray-300 uppercase tracking-wider text-xs md:text-sm font-medium">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
