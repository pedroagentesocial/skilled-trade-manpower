---
import Layout from '../../layouts/Layout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { useTranslations, getLangFromUrl, getTranslatedPath } from '../../utils/i18n';
import { icons } from '../../utils/icons';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const values = [
  {
    title: "Responsabilidad",
    desc: "Somos dueños del resultado. Si el trabajo no se hace bien, lo arreglamos. Usted no gestiona a los trabajadores; nosotros lo hacemos.",
    icon: icons['clipboard-document-check']
  },
  {
    title: "Eficiencia",
    desc: "Nuestros equipos gestionados comienzan a trabajar de inmediato. No se pierde tiempo de capacitación por su parte.",
    icon: icons['bolt']
  },
  {
    title: "Seguridad",
    desc: "Hacemos cumplir estrictos protocolos de seguridad. Nuestros supervisores aseguran que cada sitio de trabajo cumpla con las normas y sea seguro.",
    icon: icons['shield-check']
  },
  {
    title: "Calidad",
    desc: "No solo enviamos cuerpos; entregamos trabajo terminado que cumple con sus estándares.",
    icon: icons['check-badge']
  }
];
---

<Layout title="Nosotros">
  <div class="relative overflow-hidden bg-gradient-to-br from-blue-900 via-blue-900 to-blue-950 py-24 text-white text-center">
    <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-cyan-500/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 left-0 h-72 w-72 rounded-full bg-blue-600/20 blur-3xl"></div>
    <div class="container mx-auto px-4 relative z-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-300">Quiénes Somos</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold">Sobre Skilled Trade Manpower</h1>
      <p class="mt-5 text-xl text-blue-100 max-w-2xl mx-auto leading-relaxed">
        Somos su socio de ejecución. Nos hacemos cargo del trabajo para que usted no tenga que hacerlo.
      </p>
      <div class="mx-auto mt-6 h-1 w-20 rounded-full bg-gradient-to-r from-blue-500 to-cyan-400"></div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-20">
    <div class="max-w-5xl mx-auto">
      
      <!-- Mission Section -->
      <div class="mb-20 grid md:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl ring-1 ring-gray-200">
          <img src={import.meta.env.BASE_URL === '/' ? '/images/construction.jpg' : `${import.meta.env.BASE_URL}/images/construction.jpg`} alt="Cuadrilla de Skilled Trade Manpower" class="w-full h-[380px] lg:h-[440px] object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-blue-950/55 to-transparent"></div>
        </div>
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Nuestra Misión</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">Entregamos resultados, no solo personal</h2>
          <div class="mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500"></div>
          <p class="mt-6 text-lg text-gray-700 leading-relaxed">
            En Skilled Trade Manpower, nuestra misión es entregar resultados. Notamos un vacío en el mercado: los dueños de negocios estaban cansados del modelo de "agencia de empleo" donde pagan por cabezas pero aún tienen que gestionar las manos.
          </p>
          <div class="mt-6 rounded-2xl bg-blue-50 p-6 ring-1 ring-blue-100">
            <p class="text-lg text-gray-700 leading-relaxed italic">
              "Cambiamos el modelo. Brindamos servicios 'llave en mano' donde contratamos, capacitamos, gestionamos y supervisamos la fuerza laboral. Usted simplemente define el proyecto y nosotros lo ejecutamos."
            </p>
          </div>
        </div>
      </div>

      <!-- Values Grid -->
      <div class="text-center mb-12">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Lo Que Nos Mueve</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">Nuestros Valores</h2>
        <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500"></div>
      </div>
      <div class="reveal-stagger grid grid-cols-1 md:grid-cols-2 gap-6 mb-20">
        {values.map((val) => (
            <div class="group flex flex-col items-center text-center bg-white p-8 rounded-2xl shadow-sm ring-1 ring-gray-100 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-blue-500/10 hover:ring-blue-100 transition-all duration-300">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md shadow-blue-600/25 flex items-center justify-center mb-6 flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
                    <div class="w-7 h-7 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:text-white" set:html={val.icon}></div>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">{val.title}</h3>
                <p class="text-gray-600 leading-relaxed">{val.desc}</p>
            </div>
        ))}
      </div>
      
      <!-- Story Section -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-900 via-blue-900 to-blue-950 p-8 md:p-14 shadow-2xl ring-1 ring-white/10">
        <div class="pointer-events-none absolute -top-20 right-0 h-64 w-64 rounded-full bg-cyan-500/15 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-20 left-0 h-64 w-64 rounded-full bg-blue-600/20 blur-3xl"></div>
        <div class="relative z-10 max-w-3xl mx-auto text-center">
            <span class="text-cyan-300 font-bold tracking-[0.18em] uppercase text-sm mb-3 block">Desde el Primer Día</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Nuestra Historia</h2>
            <p class="text-lg text-blue-100 mb-6 leading-relaxed">
                Fundada en Salt Lake City, Skilled Trade Manpower evolucionó de un proveedor de mano de obra tradicional a un socio de ejecución de servicio completo.
                Nos dimos cuenta de que nuestros clientes necesitaban más que solo personas: necesitaban proyectos completados.
            </p>
            <p class="text-lg text-blue-100 leading-relaxed">
                Hoy, servimos a empresas en construcción, logística y gestión de instalaciones, proporcionando el músculo operativo que necesitan para escalar sin la carga de RR.HH.
            </p>
        </div>
      </div>

    </div>
  </div>

  <ContactCTA 
    title={t('home.hero.ctaPrimary')}
    subtitle={t('forms.contact.subtitle')}
    primaryText={t('buttons.getQuote')}
    primaryHref={getTranslatedPath('contact', lang)}
  />
</Layout>
