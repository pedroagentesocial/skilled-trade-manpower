---
import Layout from '../layouts/Layout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { useTranslations, getLangFromUrl, getTranslatedPath } from '../utils/i18n';
import { icons } from '../utils/icons';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const values = [
  {
    title: "Accountability",
    desc: "We own the outcome. If the work isn't done right, we fix it. You don't manage the workers; we do.",
    icon: icons['clipboard-document-check']
  },
  {
    title: "Efficiency",
    desc: "Our managed teams hit the ground running. No training time wasted on your end.",
    icon: icons['bolt']
  },
  {
    title: "Safety",
    desc: "We enforce strict safety protocols. Our supervisors ensure every job site is compliant and safe.",
    icon: icons['shield-check']
  },
  {
    title: "Quality",
    desc: "We don't just send bodies; we deliver finished work that meets your standards.",
    icon: icons['check-badge']
  }
];
---

<Layout title="About Us">
  <div class="relative overflow-hidden bg-gradient-to-br from-blue-900 via-blue-900 to-blue-950 py-24 text-white text-center">
    <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-cyan-500/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 left-0 h-72 w-72 rounded-full bg-blue-600/20 blur-3xl"></div>
    <div class="container mx-auto px-4 relative z-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-300">Who We Are</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold">About Skilled Trade Manpower</h1>
      <p class="mt-5 text-xl text-blue-100 max-w-2xl mx-auto leading-relaxed">
        We are your execution partner. We take ownership of the work so you don't have to.
      </p>
      <div class="mx-auto mt-6 h-1 w-20 rounded-full bg-gradient-to-r from-blue-500 to-cyan-400"></div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-20">
    <div class="max-w-5xl mx-auto">
      
      <!-- Mission Section -->
      <div class="mb-20 grid md:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl ring-1 ring-gray-200">
          <img src={import.meta.env.BASE_URL === '/' ? '/images/construction.jpg' : `${import.meta.env.BASE_URL}/images/construction.jpg`} alt="Skilled Trade Manpower crew" class="w-full h-[380px] lg:h-[440px] object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-blue-950/55 to-transparent"></div>
        </div>
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Our Mission</p>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">We deliver results, not just headcount</h2>
          <div class="mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500"></div>
          <p class="mt-6 text-lg text-gray-700 leading-relaxed">
            At Skilled Trade Manpower, our mission is to deliver results. We noticed a gap in the market: business owners were tired of the "staffing agency" model where they pay for heads but still have to manage the hands.
          </p>
          <div class="mt-6 rounded-2xl bg-blue-50 p-6 ring-1 ring-blue-100">
            <p class="text-lg text-gray-700 leading-relaxed italic">
              "We flipped the model. We provide 'Done-For-You' services where we hire, train, manage, and supervise the workforce. You simply define the project, and we execute it."
            </p>
          </div>
        </div>
      </div>

      <!-- Values Grid -->
      <div class="text-center mb-12">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">What Drives Us</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">Our Core Values</h2>
        <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500"></div>
      </div>
      <div class="reveal-stagger grid grid-cols-1 md:grid-cols-2 gap-6 mb-20">
        {values.map((val) => (
            <div class="group flex flex-col items-center text-center bg-white p-8 rounded-2xl shadow-sm ring-1 ring-gray-100 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-blue-500/10 hover:ring-blue-100 transition-all duration-300">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md shadow-blue-600/25 flex items-center justify-center mb-6 flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
                    <div class="w-7 h-7 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:text-white" set:html={val.icon}></div>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">{val.title}</h3>
                <p class="text-gray-600 leading-relaxed">{val.desc}</p>
            </div>
        ))}
      </div>
      
      <!-- Story Section -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-900 via-blue-900 to-blue-950 p-8 md:p-14 shadow-2xl ring-1 ring-white/10">
        <div class="pointer-events-none absolute -top-20 right-0 h-64 w-64 rounded-full bg-cyan-500/15 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-20 left-0 h-64 w-64 rounded-full bg-blue-600/20 blur-3xl"></div>
        <div class="relative z-10 max-w-3xl mx-auto text-center">
            <span class="text-cyan-300 font-bold tracking-[0.18em] uppercase text-sm mb-3 block">Since Day One</span>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Our Story</h2>
            <p class="text-lg text-blue-100 mb-6 leading-relaxed">
                Founded in Salt Lake City, Skilled Trade Manpower evolved from a traditional labor provider into a full-service execution partner.
                We realized our clients needed more than just people—they needed projects completed.
            </p>
            <p class="text-lg text-blue-100 leading-relaxed">
                Today, we serve businesses across construction, logistics, and facility management, providing the operational muscle they need to scale without the HR burden.
            </p>
        </div>
      </div>

    </div>
  </div>

  <ContactCTA 
    title={t('home.hero.ctaPrimary')}
    subtitle={t('forms.contact.subtitle')}
    primaryText={t('buttons.getQuote')}
    primaryHref={getTranslatedPath('contact', lang)}
  />
</Layout>
