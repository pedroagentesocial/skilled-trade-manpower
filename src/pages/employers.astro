---
import Layout from '../layouts/Layout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { useTranslations, getLangFromUrl, getTranslatedPath } from '../utils/i18n';
import { icons } from '../utils/icons';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  {
    key: 'recruiting',
    icon: icons['magnifying-glass'],
    color: 'bg-blue-50 text-blue-600'
  },
  {
    key: 'digital',
    icon: icons['computer-desktop'],
    color: 'bg-purple-50 text-purple-600'
  },
  {
    key: 'workforce',
    icon: icons['tools'],
    color: 'bg-orange-50 text-orange-600'
  }
];
---

<Layout title={t('nav.employers')}>
  <div class="relative overflow-hidden bg-gradient-to-br from-blue-900 via-blue-900 to-blue-950 py-24 text-white text-center">
    <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-cyan-500/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 left-0 h-72 w-72 rounded-full bg-blue-600/20 blur-3xl"></div>
    <div class="container mx-auto px-4 relative z-10">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-300">{lang === 'en' ? 'For Employers' : 'Para Empleadores'}</p>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold">{t('employers.title')}</h1>
      <p class="mt-5 text-xl text-blue-100 max-w-3xl mx-auto">
        {t('employers.subtitle')}
      </p>
      <div class="mt-8">
        <a href={getTranslatedPath('contact', lang)} class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-white text-blue-900 font-bold shadow-lg hover:-translate-y-0.5 hover:shadow-xl transition-all duration-300">
          {t('buttons.requestTalent')}
        </a>
      </div>
    </div>
  </div>

  <div class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center mb-14">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">{lang === 'en' ? 'Why Partner With Us' : 'Por Qué Elegirnos'}</p>
        <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">{lang === 'en' ? 'Why Choose Us?' : '¿Por qué elegirnos?'}</h2>
        <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500"></div>
        <p class="mt-6 text-xl text-gray-600 leading-relaxed">
          {t('employers.whyUs')}
        </p>
      </div>

      <div class="reveal-stagger grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
        {features.map(feature => (
          <div class="group p-8 rounded-2xl ring-1 ring-gray-100 shadow-sm hover:-translate-y-1.5 hover:shadow-xl hover:shadow-blue-500/10 hover:ring-blue-100 transition-all duration-300">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md shadow-blue-600/25 flex items-center justify-center mb-6 transition-transform duration-300 group-hover:scale-110">
              <span class="w-8 h-8 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:text-white" set:html={feature.icon}></span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">{t(`employers.features.${feature.key}`)}</h3>
            <p class="text-gray-600">
              {feature.key === 'recruiting' && t('services.recruiting.desc')}
              {feature.key === 'digital' && t('services.socialHiring.desc')}
              {feature.key === 'workforce' && t('services.skilledLabor.desc')}
            </p>
          </div>
        ))}
      </div>

      <!-- New Benefits Section -->
      <div class="bg-blue-50 rounded-3xl p-8 md:p-16 ring-1 ring-blue-100">
        <div class="text-center mb-12">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">{lang === 'en' ? 'The Advantage' : 'La Ventaja'}</p>
            <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">{t('employers.benefits.title')}</h2>
            <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500"></div>
        </div>
        <div class="reveal-stagger grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {[0, 1, 2, 3].map(i => (
                <div class="group bg-white p-6 rounded-2xl shadow-sm ring-1 ring-blue-100 hover:-translate-y-1.5 hover:shadow-lg hover:shadow-blue-500/10 transition-all duration-300">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-500 text-white shadow-md shadow-blue-600/25 flex items-center justify-center mb-5 transition-transform duration-300 group-hover:scale-110">
                        {i === 0 && <span class="w-6 h-6 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:text-white" set:html={icons.clock}></span>}
                        {i === 1 && <span class="w-6 h-6 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:text-white" set:html={icons['user-group']}></span>}
                        {i === 2 && <span class="w-6 h-6 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:text-white" set:html={icons['currency-dollar']}></span>}
                        {i === 3 && <span class="w-6 h-6 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:text-white" set:html={icons['chart-bar']}></span>}
                    </div>
                    <h3 class="font-bold text-gray-900 mb-2 text-lg">{t(`employers.benefits.items.${i}.title`)}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed">{t(`employers.benefits.items.${i}.desc`)}</p>
                </div>
            ))}
        </div>
      </div>
    </div>
  </div>

  <ContactCTA 
    title="Ready to build your team?"
    subtitle={t('forms.contact.subtitle')}
    primaryText={t('buttons.requestTalent')}
    primaryHref={getTranslatedPath('contact', lang)}
  />
</Layout>
