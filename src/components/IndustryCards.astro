---
import { getLangFromUrl, useTranslations, getTranslatedPath } from '../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const industries = [
  { 
    key: 'healthcare', 
    image: 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80',
    link: getTranslatedPath('industries/healthcare', lang)
  },
  { 
    key: 'construction', 
    image: import.meta.env.BASE_URL === '/' ? '/images/construction.jpg' : `${import.meta.env.BASE_URL}/images/construction.jpg`,
    link: getTranslatedPath('industries/construction', lang)
  },
  { 
    key: 'technology', 
    image: import.meta.env.BASE_URL === '/' ? '/images/Technology.jpg' : `${import.meta.env.BASE_URL}/images/Technology.jpg`,
    link: getTranslatedPath('industries/technology', lang)
  },
  { 
    key: 'generalLabor', 
    image: import.meta.env.BASE_URL === '/' ? '/images/general.jpg' : `${import.meta.env.BASE_URL}/images/general.jpg`,
    link: getTranslatedPath('industries/general-labor', lang)
  },
];
---

<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-14">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">{t('home.industries.eyebrow')}</p>
      <h2 class="mt-3 text-3xl md:text-4xl font-bold text-gray-900">{t('home.industries.title')}</h2>
      <p class="mt-4 text-xl text-gray-600 max-w-2xl mx-auto">{t('home.industries.subtitle')}</p>
      <div class="mx-auto mt-4 h-1 w-20 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500"></div>
    </div>

    <div class="reveal-stagger grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {industries.map(ind => (
        <a href={ind.link} class="group block bg-white rounded-2xl overflow-hidden shadow-md ring-1 ring-gray-100 hover:shadow-xl hover:shadow-blue-500/10 hover:ring-blue-200 transition-all duration-300 transform hover:-translate-y-1.5">
          <div class="h-48 overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-t from-blue-900/30 to-transparent group-hover:from-blue-900/10 transition-colors z-10"></div>
            <img src={ind.image} alt={t(`industries.${ind.key}.title`)} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors flex items-center gap-2">
              {t(`industries.${ind.key}.title`)}
              <span class="text-blue-500 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">&rarr;</span>
            </h3>
            <p class="text-gray-500 mt-2 text-sm">{t(`industries.${ind.key}.desc`)}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-14">
      <a href={getTranslatedPath('contact', lang)} class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500 text-white font-bold shadow-lg shadow-blue-600/25 hover:shadow-xl hover:shadow-blue-600/30 hover:-translate-y-0.5 transition-all duration-300">
        {t('buttons.requestTalent')}
      </a>
    </div>
  </div>
</section>
